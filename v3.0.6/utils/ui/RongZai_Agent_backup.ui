  <property name="styleSheet">
   <string notr="true">/* 按钮样式：科技蓝主色调 */
QPushButton {
    background-color: #3498db;
    color: white;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    font-size: 18px;
    font-weight: 500;
    padding: 8px 18px;
    border-radius: 6px;
    border: none;
}
QPushButton:hover {
    background-color: #2980b9;
}
QPushButton:pressed {
    background-color: #2471a3;
}

/* 主按钮强化（预测按钮） */
QPushButton#predict_button {
    background-color: #2ecc71;
    font-size: 14px;
    padding: 10px 24px;
}
QPushButton#predict_button:hover {
    background-color: #27ae60;
}

/* 输入框样式：深色透明+细边框 */
QLineEdit {
    color: black;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    font-size: 13px;
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid rgba(155, 164, 180, 0.3);
}
QLineEdit:focus {
    border: 1px solid #3498db;
}
QLineEdit::placeholder {
    color: rgba(155, 164, 180, 0.5);
}

/* 图形视图：深色背景+圆角 */
QGraphicsView {
    border-radius: 8px;
    border: 1px solid rgba(155, 164, 180, 0.2);
}
   </string>
