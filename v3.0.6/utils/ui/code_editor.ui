<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>CodeEditor</class>
 <widget class="QWidget" name="CodeEditor">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1200</width>
    <height>800</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>800</width>
    <height>600</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>Python 脚本编辑器 - RZera</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <layout class="QHBoxLayout" name="toolbar_layout">
     <property name="spacing">
      <number>6</number>
     </property>
     <item>
      <widget class="QPushButton" name="set_module_path_button">
       <property name="toolTip">
        <string>设置自定义Python模块的搜索路径</string>
       </property>
       <property name="text">
        <string>设置模块路径</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="set_python_exec_button">
       <property name="toolTip">
        <string>选择用于运行脚本的 Python 可执行文件（例如 openRongzai\python.exe）</string>
       </property>
       <property name="text">
        <string>选择解释器</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="module_path_label">
       <property name="toolTip">
        <string>当前自定义模块路径</string>
       </property>
       <property name="text">
        <string>模块路径: 未设置</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="python_exec_label">
       <property name="toolTip">
        <string>当前用于子进程的 Python 可执行文件</string>
       </property>
       <property name="text">
        <string>解释器: 未设置</string>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="horizontalSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="new_button">
       <property name="text">
        <string>新建</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="open_button">
       <property name="text">
        <string>打开</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="save_button">
       <property name="text">
        <string>保存</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="save_as_button">
       <property name="text">
        <string>另存为</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="run_button">
       <property name="styleSheet">
        <string>QPushButton { background-color: #4CAF50; color: white; font-weight: bold; }</string>
       </property>
       <property name="text">
        <string>运行脚本 (F5)</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="stop_button">
       <property name="enabled">
        <bool>false</bool>
       </property>
       <property name="styleSheet">
        <string>QPushButton { background-color: #f44336; color: white; }</string>
       </property>
       <property name="text">
        <string>停止执行</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="clear_output_button">
       <property name="text">
        <string>清空输出</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QSplitter" name="main_splitter">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
       <horstretch>0</horstretch>
       <verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <widget class="QTreeView" name="file_tree_view">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
        <horstretch>0</horstretch>
        <verstretch>0</verstretch>
       </sizepolicy>
      </property>
      <property name="minimumSize">
       <size>
        <width>180</width>
        <height>400</height>
       </size>
      </property>
     </widget>
     <widget class="QSplitter" name="editor_splitter">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
        <horstretch>0</horstretch>
        <verstretch>0</verstretch>
       </sizepolicy>
      </property>
      <property name="orientation">
       <enum>Qt::Vertical</enum>
      </property>
      <widget class="QsciScintilla" name="code_text_edit" native="true">
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
         <horstretch>0</horstretch>
         <verstretch>0</verstretch>
        </sizepolicy>
       </property>
       <property name="font">
        <font>
         <family>Consolas</family>
         <pointsize>11</pointsize>
        </font>
       </property>
      </widget>
      <widget class="QWidget" name="output_widget" native="true">
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
         <horstretch>0</horstretch>
         <verstretch>0</verstretch>
        </sizepolicy>
       </property>
       <layout class="QVBoxLayout" name="output_layout">
        <property name="topMargin">
         <number>0</number>
        </property>
        <item>
         <widget class="QLabel" name="label_output">
          <property name="text">
           <string>输出结果:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QTextEdit" name="output_text_edit">
          <property name="font">
           <font>
            <family>Consolas</family>
            <pointsize>10</pointsize>
           </font>
          </property>
          <property name="styleSheet">
           <string>background-color: #2b2b2b; color: #ffffff;</string>
          </property>
          <property name="readOnly">
           <bool>true</bool>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="status_label">
     <property name="text">
      <string>就绪</string>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>QsciScintilla</class>
   <extends>QWidget</extends>
   <header>qsciscintilla.h</header>
  </customwidget>
